# Copiar a /root/stack/env/prbar-relay.env (modo 600) en el VPS y completar ahí. Nunca al repo.
RELAY_PUBLIC_HOST=
# 32 bytes al azar, generados en el server: openssl rand -hex 32
RELAY_ENROLL_TOKEN=
RELAY_MAX_ACCOUNTS=4
# Web Push (spec W.6): el escalar d (32 bytes, base64url sin relleno) de una clave P-256. Lo genera deploy.sh en el
# server la primera vez si falta. Sin él, el relay arranca con los pushes apagados.
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push: mailto:… o https://… (por defecto https://RELAY_PUBLIC_HOST).
VAPID_SUBJECT=
# Solo para recuperarse de un compromiso del server (relay/README.md): `1` manda Clear-Site-Data: "cache" con /sw.js.
# Apagarlo (vacío) una vez que los teléfonos abrieron la app.
RELAY_CLEAR_SITE_DATA=
